# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Comma-separated provider API keys (at least two). Order defines key_1, key_2, ...
LLM_API_KEYS=your-first-api-key,your-second-api-key

# LiteLLM model name used for every key (provider/model).
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Optional: per-key model override, aligned with LLM_API_KEYS. Leave empty to use LLM_MODEL
# for all keys. Example mixing providers:
#   LLM_MODELS=gemini/gemini-3.5-flash-lite,groq/llama-3.1-8b-instant
LLM_MODELS=

# Optional custom endpoint for OpenAI-compatible gateways (leave empty for native providers).
LLM_API_BASE=

# Per-attempt provider timeout (seconds) and optional output cap.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=

# System prompt used when the client does not send one.
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
MAX_HISTORY_MESSAGES=50

# SQLite database (file must live on the persistent /data volume in Docker).
DATABASE_URL=sqlite:////data/app.db

# LiteLLM in-memory response cache.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=1000

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure test header on POST /chat.
ENABLE_FAILURE_SIMULATION=true

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Backend URL the browser calls. Injected at container start (docker compose).
FRONTEND_API_BASE_URL=http://localhost:8000
# Build-time equivalent for static hosts (Vercel/Netlify/Render static site):
VITE_API_BASE_URL=http://localhost:8000
